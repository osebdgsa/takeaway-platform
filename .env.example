ENVIRONMENT=development
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Used by docker compose
POSTGRES_DB=takeaway
POSTGRES_USER=takeaway
POSTGRES_PASSWORD=takeaway
POSTGRES_PORT=5432
API_PORT=8000
HTTP_PORT=8080

# Used when running the app/tests directly on the host
DATABASE_URL=postgresql+psycopg2://takeaway:takeaway@localhost:5432/takeaway

# JSON array; empty means no cross-origin browser access
CORS_ORIGINS=[]
