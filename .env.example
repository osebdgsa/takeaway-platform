ENVIRONMENT=development
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Used by docker compose
POSTGRES_DB=takeaway
POSTGRES_USER=takeaway
POSTGRES_PASSWORD=takeaway
POSTGRES_PORT=5432
API_PORT=8000
HTTP_PORT=8080
# Vite dev server port, used by compose.dev.yml (`make dev`)
VITE_PORT=5173

# Used when running the app directly on the host (tests use an in-memory DB)
DATABASE_URL=postgresql+psycopg2://takeaway:takeaway@localhost:5432/takeaway

# JSON array; empty means no cross-origin browser access
CORS_ORIGINS=[]
